        {
          "label": "Engine Failure In Flight",
          "value": "1. Maintain control, lower collective 2. Collective - adjust for 90-111% NR 3. Cyclic - 60 KIAS recommended 4. Flare and cushion landing"
        },
        {
          "label": "Engine Failure Hovering",
          "value": "1. Maintain control 2. Collective - control NR/descent 3. Any forward speed helps 4. Cushion landing"
        },
        {
          "label": "Driveshaft Failure",
          "value": "1. Establish autorotation immediately 2. Collective - maintain 90-111% NR 3. 50 KIAS min descent, 70 KIAS max glide 4. Complete autorotative landing"
        },
        {
          "label": "Engine Fire In Flight",
          "value": "1. Confirm fire 2. Enter autorotation 3. ENGINE - OFF 4. Emergency fuel shutoff if needed"
        },
        {
          "label": "Complete Loss Tail Rotor Thrust",
          "value": "1. If can't maintain level flight - autorotation, min 40 KIAS 2. THROTTLE - IDLE 3. Maintain forward speed on landing"
        },
        {
          "label": "Hydraulic Loss of Pressure",
          "value": "1. Adjust to 50-80 KIAS 2. HYD SYS - OFF 3. 100 KIAS for extended flight 4. Run-on landing ~15 knots"
        },
        {
          "label": "Generator Failure",
          "value": "1. GEN - OFF then ON 2. If no restore, GEN - OFF 3. Battery ~33 min basic systems 4. Land as soon as practical"
