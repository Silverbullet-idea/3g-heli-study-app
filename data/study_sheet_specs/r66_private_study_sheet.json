      "items": [
        {
          "label": "Power Failure",
          "value": "1. Lower collective immediately 2. Establish 70 KIAS 3. Keep RPM 95-106% 4. Flare at 40 ft AGL 5. Level at 8 ft, cushion landing"
        },
        {
          "label": "Tail Rotor Failure (forward)",
          "value": "1. Close throttle, enter autorotation 2. Maintain 70+ KIAS 3. Select landing site"
        },
        {
          "label": "Tail Rotor Failure (hover)",
          "value": "1. Close throttle immediately 2. Allow to settle 3. Cushion with collective"
        },
        {
          "label": "Engine Fire (flight)",
          "value": "1. Enter autorotation 2. Cabin heat OFF 3. Land immediately 4. Fuel cutoff OFF, fuel valve OFF"
        },
        {
          "label": "Engine Fire (ground)",
          "value": "1. Fuel cutoff OFF 2. Push start button 3. Fuel valve OFF 4. Battery OFF when MGT <150°C"
        },
        {
          "label": "Electrical Fire",
          "value": "1. Battery and generator OFF 2. Open vents 3. Land immediately 4. Fuel cutoff and valve OFF"
        },
        {
          "label": "Hydraulic Failure",
          "value": "1. Verify HYD switch ON 2. If not restored, HYD switch OFF 3. Adjust for comfortable control 4. Land ASAP"
        },
        {
          "label": "Low RPM Horn",
          "value": "1. Lower collective 2. Verify throttle full open 3. Apply aft cyclic (forward flight)"
        }
