    {
      "section_id": "emergency_procedures",
      "section_title": "Emergency Procedures (Condensed)",
      "items": [
        {
          "label": "Engine failure above 450 ft",
          "value": "1. Lower collective 2. Enter autorotation 3. 52 kt glide 4. Flare at 50 ft 5. Collective/cyclic at 10 ft 6. Level attitude ground contact"
        },
        {
          "label": "Engine failure 7-450 ft",
          "value": "1. Lower collective (altitude permitting) 2. Maintain rotor RPM 3. Aft cyclic/collective as ground approached 4. Level attitude 5. Collective to cushion"
        },
        {
          "label": "Engine failure below 7 ft",
          "value": "1. Do NOT reduce collective 2. Right pedal prevent yaw 3. Right cyclic minimize drift 4. Collective cushion landing"
        },
        {
          "label": "Tail rotor failure forward flight",
          "value": "1. Reduce power/collective 2. 50-60 kt airspeed 3. Left lateral cyclic limit sideslip 4. Idle throttle/autorotation 5. Minimal forward speed touchdown"
        },
        {
          "label": "Tail rotor failure hover",
          "value": "1. Idle throttle immediately 2. Hovering autorotation"
        },
        {
          "label": "Engine fire on ground",
          "value": "1. Mixture idle cutoff 2. Fuel valve close 3. Battery OFF 4. Alternator OFF 5. Exit with extinguisher"
        },
        {
          "label": "Engine fire in flight",
          "value": "1. Immediate power-on landing 2. Battery/Alternator OFF if time 3. Upon landing: throttle close, mixture cutoff, fuel close 4. Exit/extinguish"
        },
        {
          "label": "Air restart",
          "value": "1. 52 kt autorotation 2. If >2000 ft: crack throttle 1/2 inch 3. Engage starter 4. Mixture full rich when fires"
        }
      ]
    },
