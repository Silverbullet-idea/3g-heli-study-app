      "items": [
        {
          "label": "Engine Fire (Start/Shutdown)",
          "value": "1. Starter - Continue motoring 2. Throttle - Full closed 3. FUEL VALVE - OFF 4. IGN ENG CB - Out 5. Complete shutdown"
        },
        {
          "label": "Engine Fire (Flight)",
          "value": "1. Throttle - Close 2. Enter autorotation 3. FUEL VALVE - OFF 4. BAT - OFF 5. Autorotative landing"
        },
        {
          "label": "Engine Failure",
          "value": "1. Collective - Adjust for 90-107% NR 2. Airspeed - 52-69 KIAS 3. Flare at low altitude 4. Cushion with collective 5. Level touchdown before 70% NR"
        },
        {
          "label": "Driveshaft Failure",
          "value": "1. Collective - Maintain 90-107% NR 2. Throttle - Open 3. Autorotative airspeed 52-69 KIAS 4. Complete autorotative landing"
        },
        {
          "label": "Tail Rotor Loss",
          "value": "1. Throttle - Flight idle, enter autorotation 2. Minimum 50 KIAS 3. Reduce to 61-69 KIAS 4. Touchdown with throttle closed"
        },
        {
          "label": "Hydraulic Failure",
          "value": "1. Airspeed - 61-69 KIAS 2. HYD BOOST CB - Cycle 3. CONTROL BOOST - Cycle 4. Run-on landing 10-15 knots"
        },
        {
          "label": "Generator Failure",
          "value": "1. GEN - RESET then ON 2. If fails: GEN - OFF 3. Electrical equipment - OFF 4. Required only - ON 5. Land ASAP"
        },
        {
          "label": "ENG OUT Light",
          "value": "1. Reduce pitch - Autorotate 2. If altitude permits - Investigate"
