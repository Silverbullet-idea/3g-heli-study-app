        {
          "label": "Power failure >500 ft AGL",
          "value": "1. Lower collective (maintain RPM) 2. Glide 65 KIAS 3. Keep RPM 97-110% 4. Land into wind 5. Flare at 40 ft 6. Level at 8 ft, raise collective"
        },
        {
          "label": "Power failure 8-500 ft AGL",
          "value": "1. Lower collective (maintain RPM) 2. Keep RPM 97-110% 3. Maintain airspeed until flare 4. Flare, level at 8 ft, raise collective"
        },
        {
          "label": "Power failure <8 ft AGL",
          "value": "1. Right pedal (prevent yaw) 2. Allow aircraft to settle 3. Raise collective before touchdown"
        },
        {
          "label": "Air restart procedure",
          "value": "1. Mixture full rich 2. Primer locked 3. Throttle closed, crack open 4. Actuate starter"
        },
        {
          "label": "Tail rotor failure (forward)",
          "value": "1. Enter autorotation immediately 2. Maintain 70+ KIAS 3. Roll throttle off, autorotate"
        },
        {
          "label": "Tail rotor failure (hover)",
          "value": "1. Roll throttle off immediately 2. Allow aircraft to settle 3. Raise collective before touchdown"
        },
        {
          "label": "Engine fire in flight",
          "value": "1. Enter autorotation 2. Cabin heat OFF 3. Land normally if running 4. Mixture/fuel OFF 5. Battery OFF"
        },
        {
          "label": "Low G recovery",
          "value": "1. Gradually apply aft cyclic 2. Restore positive G forces 3. Do not use lateral cyclic until positive G established"
