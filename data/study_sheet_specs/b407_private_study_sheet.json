        {
          "label": "Engine Failure (Hovering)",
          "value": "1. Maintain heading/attitude 2. Collective adjust for NR/descent 3. Land 4. Shut down"
        },
        {
          "label": "Engine Failure (Flight)",
          "value": "1. Maintain heading/attitude 2. Collective for 85-107% NR 3. Cyclic for desired airspeed 4. Attempt restart if altitude permits 5. FUEL VALVE OFF 6. Autorotative landing"
        },
        {
          "label": "Engine Hot Start",
          "value": "1. Throttle CLOSED 2. FUEL VALVE OFF 3. STARTER continue until MGT stabilizes 4. Shut down"
        },
        {
          "label": "FADEC Failure",
          "value": "1. Throttle match to NG 2. NR/NP maintain 95-100% 3. FADEC MODE press once 4. Land ASAP"
        },
        {
          "label": "Complete TR Thrust Loss",
          "value": "Hover: Close throttle, autorotative landing | Flight: Throttle idle, autorotate min 55 KIAS"
        },
        {
          "label": "Hydraulic Failure",
          "value": "1. Airspeed 70-100 KIAS 2. HYD SYSTEM CB out/in 3. HYD SYS OFF if no restore 4. Land ASAP"
        },
        {
          "label": "Generator Failure",
          "value": "1. Check CB in 2. GEN RESET then ON 3. If no restore GEN OFF, land ASAP"
        },
        {
          "label": "Engine Fire (Flight)",
          "value": "1. Autorotation 2. Throttle CLOSED 3. FUEL VALVE OFF 4. Land 5. BATT OFF"
